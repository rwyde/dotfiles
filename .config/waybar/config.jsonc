// -*- mode: jsonc -*-
[
  {
    "output": ["DP-1", "eDP-1"],
    "include": ["~/.config/waybar/default-modules.jsonc"],
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    "spacing": 3, //4, // Gaps between modules (4px)
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/submap",
        "sway/scratchpad",
        "custom/media"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "mpd",
        // "pulseaudio",
        "cpu",
        "memory",
        "temperature",
        "clock",
        "custom/wiggly-stt",
        "tray",
        "custom/power",
    ],
  },
  {
    "output": ["DP-2"],
    "include": ["~/.config/waybar/default-modules.jsonc"],
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    "spacing": 3, //4, // Gaps between modules (4px)
    "modules-left": [
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "hyprland/workspaces",
        "hyprland/submap",
        "sway/scratchpad",
        "custom/media"
    ],
  },
]
